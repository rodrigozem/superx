# Copie para .env.local e preencha com valores próprios.
# Gere um segredo com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Credenciais do usuário administrador.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@empresa.com

# Hash bcrypt da senha. Gere com:  npm run hash -- "SuaSenhaForte"
# IMPORTANTE: no arquivo .env o caractere "$" deve ser escapado como "\$".
ADMIN_PASSWORD_HASH=

# Caminho do banco SQLite (opcional).
# Padrão: data/app.db dentro da pasta do projeto.
# Em hospedagem que redeploya a pasta do app (Hostinger), aponte para fora dela
# para os usuários cadastrados não sumirem a cada deploy. Aceita ~/.
# DB_PATH=/home/USUARIO/dados-sistema/app.db
